# Puerto del servidor
PORT=3000

# Clave de Football-Data.org (https://www.football-data.org/client/register)
# Si se deja vacía, el backend sirve el dataset local de fútbol.
FOOTBALL_DATA_API_KEY=

# Competición de Football-Data.org. PD = Primera División (Liga EA Sports).
FOOTBALL_DATA_COMPETITION=PD

# Endpoint externo opcional para ACB. Debe devolver el contrato normalizado:
# { meta, standings[], leaders{points,valuation,rebounds,assists}, results[], scorers[] }
ACB_API_URL=

# Clave pública de la API de ACB para el detalle oficial de partidos.
# Si se deja vacía se usa la clave pública incluida en la web de ACB.
ACB_API_KEY=

# Endpoint externo opcional para ASOBAL. Debe devolver el contrato normalizado:
# { meta, standings[], scorers[], goalkeepers[], results[] }
ASOBAL_API_URL=

# Token opcional para los endpoints externos de ACB / ASOBAL
SPORTS_API_TOKEN=

# Cabecera CORS. En producción conviene limitarla al dominio del frontend.
CORS_ORIGIN=*

# Minutos de caché en memoria del backend
CACHE_TTL_MINUTES=15

# Timeout de las llamadas a proveedores externos (ms)
UPSTREAM_TIMEOUT_MS=9000

# Entorno de ejecución
NODE_ENV=development
